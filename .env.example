# 前端调用后端 API 的地址
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 后端监听地址
BACKEND_HOST=127.0.0.1

# 后端监听端口
BACKEND_PORT=8000

# 上传文件保存位置
UPLOAD_DIR=./storage/uploads

# Docling 解析结果保存位置
PARSED_DIR=./storage/parsed

# 单个文件最大大小，单位 MB
MAX_UPLOAD_SIZE_MB=50

# LibreTranslate 自托管服务地址；默认仅连接本机，不会将课件发送到公共服务
LIBRETRANSLATE_URL=http://127.0.0.1:5000
# 如本机 LibreTranslate 需要鉴权，可在私有 .env 中填写
LIBRETRANSLATE_API_KEY=

# 可选的平台 AI 服务端 OpenAI-compatible Key，作为环境配置兜底。
# 日常使用可在 AI 页面配置 OpenAI 或 DeepSeek；用户 Key 由本地 Windows DPAPI 加密保存。
PLATFORM_AI_API_KEY=
PLATFORM_AI_BASE_URL=https://api.openai.com/v1
PLATFORM_AI_MODEL=gpt-4o-mini
